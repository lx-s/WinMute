<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity Name="lx-s.WinMute"
            Publisher="CN=e0689ef6-8148-4bcd-8d1b-e72d81817643"
            Version="2.6.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>WinMute</DisplayName>
    <PublisherDisplayName>Alexander Steinhöfer</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources><Resource Language="en-us" /></Resources>

  <Applications>
    <Application Id="WinMute" Executable="WinMute.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="WinMute"
        Description="Mutes audio on lock, bluetooth and more events"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension Category="windows.startupTask"
                        Executable="WinMute.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="WinMuteStartup" Enabled="false"
                            DisplayName="WinMute" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
